{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "NITRO_PRESET=node-server npm run build"
  },
  "deploy": {
    "startCommand": "NITRO_HOST=0.0.0.0 HOST=0.0.0.0 node .output/server/index.mjs",
    "healthcheckPath": "/api/health",
    "healthcheckTimeout": 180,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
